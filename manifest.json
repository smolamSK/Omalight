{
  "schemaVersion": 1,
  "id": "io.github.vaibhavgupta5.omalight",
  "name": "Omalight",
  "version": "1.0.0",
  "author": "vaibhav",
  "license": "MIT",
  "description": "A soft edge light for video calls. Lights your face from the screen edges, with a bottom-bar icon and a popup for brightness, width, and warmth, styled to match the Omarchy theme.",
  "kinds": [
    "service",
    "panel",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "panel": "EdgeLight.qml",
    "barWidget": "EdgeLightWidget.qml"
  },
  "barWidget": {
    "displayName": "Omalight",
    "description": "Opens the Omalight control popup.",
    "category": "Utilities",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {},
    "schema": []
  }
}
